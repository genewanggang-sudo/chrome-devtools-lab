{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/devtools-mcp.mjs",
        "--browserUrl",
        "http://127.0.0.1:9333",
        "--pageIdRouting",
        "--experimentalDevtools",
        "--experimentalStructuredContent",
        "--no-category-memory",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redactNetworkHeaders"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      }
    }
  }
}
